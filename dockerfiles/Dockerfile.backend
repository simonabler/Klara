# --- Build stage -----------------------------------------------------------
FROM node:24-alpine AS build

WORKDIR /build/klara

# Install dependencies first (leverages Docker layer cache)
COPY   ./package*.json ./
RUN npm ci

# Copy workspace and build the NestJS server
COPY ./ ./
RUN rm -R ./apps/klara-e2e

# 1. datasource.ts + Migrations kompilieren (CommonJS) → dist/typeorm/
#    Muss VOR dem NX-Build laufen, damit Webpack die JS-Dateien als Assets kopieren kann.
RUN npx tsc -p apps/server/tsconfig.typeorm.json --noEmit false

# 2. NestJS App bauen (Webpack Bundle → dist/apps/server/main.js)
#    Webpack kopiert dabei dist/typeorm/.../migrations/*.js → dist/apps/server/migrations/
RUN npx nx build server

# 3. Von Nx erzeugtes package-lock.json reparieren: Nx 21.4 hebt beim Beschneiden
#    verschachtelte Pakete eine Ebene zu hoch (z. B. content-type 2.x über express 5,
#    das ^1.0.5 braucht) → `npm ci` scheitert. npm ergänzt nur fehlende Einträge,
#    alle vorhandenen Versionen bleiben gepinnt.
RUN cd dist/apps/server && npm install --package-lock-only --omit=dev --ignore-scripts --no-audit --no-fund

# --- Runtime stage ---------------------------------------------------------
FROM node:24-alpine AS runtime

ENV NODE_ENV=production

RUN apk update && apk upgrade

WORKDIR /app
RUN chown node:node -R .

USER node

# Copy built server and its production deps
# Nx erzeugt package.json + package-lock.json mit fixen Versionen (inkl. pg und sharp).
# sharp bringt vorkompilierte Binaries für Alpine (musl) mit – keine Build-Tools nötig.
COPY --from=build --chown=node:node /build/klara/dist/apps/server ./
RUN npm ci --omit=dev --ignore-scripts

COPY --chown=node:node ./apps/server/entrypoint.backend.sh .

EXPOSE 3000
CMD ["sh", "entrypoint.backend.sh"]