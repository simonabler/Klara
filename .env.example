# Datenbank (via Docker-Netzwerk)
TYPEORM_HOST=db
TYPEORM_PORT=5432
TYPEORM_DATABASE=klara
TYPEORM_USERNAME=user
TYPEORM_PASSWORD=CHANGEME
# TYPEORM_SYNC: Nur in Entwicklung auf true setzen!
# In Produktion IMMER false oder weglassen – sonst droht Datenverlust beim Neustart.
TYPEORM_SYNC=false
# TYPEORM_MIGRATIONS_RUN: Migrations beim App-Start automatisch ausführen.
# In Produktion auf true setzen – der Entrypoint führt Migrations vor dem Start aus.
# In Entwicklung mit TYPEORM_SYNC=true kann false bleiben.
TYPEORM_MIGRATIONS_RUN=false

# App
NODE_ENV=production
PORT=3000

# Auth (wird in Issue 2 benötigt)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:4200

# Metriken + Anomaly-Guard (sperrt IPs mit auffälligem Traffic automatisch)
# Nur mit Postgres wirksam. Interne/private IPs (z. B. der SSR-Frontend-Container) sind ausgenommen.
METRICS_ENABLED=true
# Token für /api/_stats (Header X-Metrics-Token), mind. 32 Zeichen, z. B. `openssl rand -hex 32`.
# Leer → die _stats-Endpunkte antworten mit 404.
METRICS_TOKEN=
# Zusätzlich ausgenommene IPs, kommagetrennt (z. B. Monitoring-Server)
ANOMALY_ALLOWLIST=
# Schwellwerte (Defaults): ANOMALY_BURST_PER_MIN=120, ANOMALY_SUSTAINED_PER_5MIN=300,
# ANOMALY_UNIQUE_ROUTES_PER_MIN=40, ANOMALY_ERROR_RATIO=0.6, ANOMALY_MIN_ERR_SAMPLES=50
